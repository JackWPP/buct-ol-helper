{
  "name": "ykt-helper-desktop",
  "productName": "雨课堂网课助手",
  "version": "1.1.0",
  "description": "雨课堂网课助手桌面客户端：连接自建的刷课服务，随手看进度、随时启停",
  "main": "src/main.js",
  "author": {
    "name": "JackWPP",
    "email": "jt846962421@outlook.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:server": "bash build-server.sh",
    "dist:mac": "npm run build:server && electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.ykt.helper.desktop",
    "productName": "雨课堂网课助手",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ykt-server",
        "to": "server"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
